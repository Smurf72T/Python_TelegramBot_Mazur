# .env.example — скопируй в .env и заполни

DB_HOST_LOCAL=localhost
DB_HOST_DOCKER=db
DB_PORT=5432
DB_NAME=calendar_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_MINCONN=1
DB_MAXCONN=10

# PostgreSQL для Docker (совместимость с docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RUN_ENV=local

TELEGRAM_BOT_TOKEN=your_token_here

# Секретный ключ Django (сгенерируйте уникальный)
SECRET_KEY=your-django-secret-key-here

# Базовый URL Django для экспорта.
# По умолчанию: http://django:8000 в Docker, http://localhost:8000 локально
EXPORT_BASE_URL=
