# .env.example — скопируй в .env и заполни

# База данных
DB_HOST_LOCAL=your_localhost         # Хост БД для локального запуска
DB_HOST_DOCKER=your_db               # Хост БД для Docker (имя сервиса)
DB_PORT=your_port                    # Порт PostgreSQL
DB_NAME=your_name_db                 # Имя базы данных
DB_USER=your_user                    # Имя пользователя БД
DB_PASSWORD=your_password            # Пароль пользователя БД
DB_MINCONN=1                         # Минимальное количество соединений
DB_MAXCONN=10                        # Максимальное количество соединений

# PostgreSQL для Docker (совместимость с docker-compose.yml)
POSTGRES_USER=your_user              # Имя пользователя PostgreSQL (для POSTGRES_USER)

# Окружение
RUN_ENV=local                        # local или docker

# Telegram бот
TELEGRAM_BOT_TOKEN=your_token_here

# Django
SECRET_KEY=your_secret_key_here

# Админка Django (пароль суперпользователя)
ADMIN_PASSWORD=your_admin_password_here

# Базовый URL Django для экспорта.
# По умолчанию: http://django:8000 в Docker, http://localhost:8000 локально
EXPORT_BASE_URL=

# Добавь .env в .gitignore!
