# =============================================================================
# Dockerfile для Telegram-бота
# =============================================================================
# Этот Dockerfile создает образ для запуска Telegram-бота приложения заметок.
# Бот отвечает за взаимодействие с пользователями через Telegram API и
# интеграцию с базой данных PostgreSQL.
# =============================================================================

# Используем легковесный образ Python 3.12.10
FROM python:3.12.10-slim

# Устанавливаем рабочую директорию /app внутри контейнера
WORKDIR /app

# =============================================================================
# Установка системных зависимостей
# =============================================================================
# - curl: утилита для выполнения HTTP-запросов (используется для healthcheck)
# - rm -rf /var/lib/apt/lists/*: очищаем кэш apt для уменьшения размера образа
# =============================================================================
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Установка Python-зависимостей
# =============================================================================
# Копируем файл requirements.txt с перечнем всех необходимых пакетов
COPY requirements.txt ./

# Устанавливаем зависимости из requirements.txt
# --no-cache-dir: отключаем кэширование pip для уменьшения размера образа
RUN pip install --no-cache-dir -r requirements.txt

# Обновляем pip до последней версии для безопасности и совместимости
RUN pip install --upgrade pip

# =============================================================================
# Копирование файлов проекта
# =============================================================================
# Копируем все файлы текущей директории в /app контейнера
# Это включает исходный код бота, модули календаря и статистики
COPY . .

# =============================================================================
# Настройка переменных окружения
# =============================================================================
# PYTHONPATH: указывает Python, где искать модули для импорта
# - /app: основная директория приложения
# - /app/django-admin-panel: директория с Django-проектом (для моделей и ORM)
ENV PYTHONPATH=/app:/app/django-admin-panel

# Открываем порт 8000 для возможных HTTP-запросов (будущее расширение)
EXPOSE 8000

# =============================================================================
# Запуск приложения
# =============================================================================
# CMD: команда, выполняемая при запуске контейнера
# - sleep 10: задержка на 10 секунд для ожидания готовности базы данных
# - python main.py: запуск основного файла бота
# Задержка необходима, так как бот должен подключиться к БД PostgreSQL,
# которая может не быть мгновенно готова при старте сервисов
CMD ["sh", "-c", "sleep 10 && python main.py"]