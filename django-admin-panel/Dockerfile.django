# =============================================================================
# Dockerfile для Django Admin Panel
# =============================================================================
# Этот Dockerfile создает образ для запуска веб-интерфейса администратора
# на базе Django Framework. Панель предоставляет REST API и админку для
# управления заметками, событиями и пользователями.
# =============================================================================

# Используем легковесный образ Python 3.12.10
FROM python:3.12.10-slim

# Устанавливаем рабочую директорию /app внутри контейнера
WORKDIR /app

# =============================================================================
# Установка системных зависимостей
# =============================================================================
# - postgresql-client: клиент PostgreSQL для выполнения SQL-команд и
#   проверки состояния базы данных (используется в скриптах инициализации)
# - rm -rf /var/lib/apt/lists/*: очищаем кэш apt для уменьшения размера образа
# =============================================================================
RUN apt-get update && apt-get install -y \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Установка Python-зависимостей
# =============================================================================
# Копируем файл requirements.txt с перечнем всех необходимых пакетов
# Путь ../requirements.txt указывает на файл в родительской директории
COPY requirements.txt ./

# Устанавливаем зависимости из requirements.txt
# --no-cache-dir: отключаем кэширование pip для уменьшения размера образа
RUN pip install --no-cache-dir -r requirements.txt

# Обновляем pip до последней версии для безопасности и совместимости
RUN pip install --upgrade pip

# =============================================================================
# Копирование файлов проекта
# =============================================================================
# Копируем все файлы из текущей директории (django-admin-panel) в /app
# Это включает Django-проект, модели, сериализаторы, представления и т.д.
COPY . .
COPY ../notes_bot ./notes_bot

# =============================================================================
# Настройка точки входа (Entrypoint)
# =============================================================================
# Копируем скрипт entrypoint.sh в корень файловой системы контейнера
# Этот скрипт выполняет подготовительные действия перед запуском приложения:
# - ожидание готовности базы данных
# - применение миграций Django
# - создание суперпользователя
COPY entrypoint.sh /entrypoint.sh

# Делаем скрипт исполняемым (chmod +x)
RUN chmod +x /entrypoint.sh

# Указываем entrypoint.sh как точку входа контейнера
# ENTRYPOINT запускается автоматически при старте контейнера
ENTRYPOINT ["/entrypoint.sh"]

# Открываем порт 8000 для доступа к веб-серверу Django
EXPOSE 8000

# =============================================================================
# Запуск приложения (по умолчанию)
# =============================================================================
# CMD: команда по умолчанию, которая выполняется после ENTRYPOINT
# Запускаем Django development server на всех сетевых интерфейсах (0.0.0.0)
# В production рекомендуется использовать gunicorn или uwsgi
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]